# Copy to .env and adjust. Never commit .env. A blank value means the default (src/incidentops_ai/config.py).
# Deployment guide: docs/deploy.md. Every setting below reaches the container under docker compose.

# ---- Required for a deployment --------------------------------------------------------------------
# docker compose only: password for the Postgres container (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me
# A machine credential with admin rights, sent as `Authorization: Bearer <token>`. At least 16
# characters; generate: openssl rand -hex 24. With an OpenAI key but no token the API stays off (503).
INCIDENTOPS_API_TOKEN=
# LLM (W02). Create a project-scoped key at platform.openai.com; never commit the real value.
OPENAI_API_KEY=
# Model name from OpenAI's pricing page. Required for real calls; tests never need it.
INCIDENTOPS_LLM_MODEL=

# ---- Database ---------------------------------------------------------------------------------------
# For running outside Docker; docker compose points the API at its own db service.
INCIDENTOPS_DATABASE_URL=postgresql+asyncpg://localhost:5432/incidentops
INCIDENTOPS_DATABASE_ECHO=false
# Connection pools (W12): larger pools took 10 to 15% off per-run overhead at 100 responders.
INCIDENTOPS_DATABASE_POOL_SIZE=5
INCIDENTOPS_DATABASE_MAX_OVERFLOW=10
INCIDENTOPS_CHECKPOINT_POOL_SIZE=5

# ---- Model calls (W02, W11) -------------------------------------------------------------------------
INCIDENTOPS_LLM_MAX_OUTPUT_TOKENS=2000
INCIDENTOPS_LLM_TIMEOUT_S=30
INCIDENTOPS_LLM_MAX_ATTEMPTS=3
INCIDENTOPS_LLM_TOTAL_TIMEOUT_S=60
# Calls per minute to the LLM endpoints, all callers together, per server process.
INCIDENTOPS_LLM_RATE_LIMIT_PER_MINUTE=10
# Model routes (W11), JSON: {"diagnosis": ["primary-model", "fallback-model"]}
INCIDENTOPS_LLM_ROUTES={}
# Calls per minute to any one model through the gateway (blank: no per-model limit).
INCIDENTOPS_LLM_PER_MODEL_PER_MINUTE=

# ---- Identity (W10) ---------------------------------------------------------------------------------
# People sign in with JWTs from your identity provider: an HS256 secret OR an RS256 public key (PEM).
INCIDENTOPS_JWT_SECRET=
INCIDENTOPS_JWT_PUBLIC_KEY=
INCIDENTOPS_JWT_ISSUER=incidentops-dev

# ---- Retrieval (W03, W04) ---------------------------------------------------------------------------
# Changing either one means re-embedding: run `python -m incidentops_ai.retrieval.index`.
# The chunks table stores 1536-dimensional vectors; text-embedding-3 models can be asked for that size.
INCIDENTOPS_EMBEDDING_MODEL=text-embedding-3-small
INCIDENTOPS_EMBEDDING_DIMENSIONS=1536
# dense, hybrid (dense + BM25; won W04), hybrid-rerank (needs `uv sync --extra rerank` and about
# 1 GB of memory) or bm25 (no embeddings at all; W12).
INCIDENTOPS_RETRIEVAL_STACK=hybrid

# ---- Knowledge graph (W05, optional) ----------------------------------------------------------------
# With `docker compose --profile graph`, use bolt://neo4j:7687 and the same password as NEO4J_PASSWORD.
INCIDENTOPS_NEO4J_URI=
INCIDENTOPS_NEO4J_USER=neo4j
INCIDENTOPS_NEO4J_PASSWORD=
# docker compose only: the password the Neo4j container is created with.
NEO4J_PASSWORD=
# off (default; W05 measured no retrieval gain), anchor, or graph.
INCIDENTOPS_GRAPH_RETRIEVAL=off

# ---- Tickets (W08, W09, optional) -------------------------------------------------------------------
# Either a Jira-style API...
INCIDENTOPS_JIRA_URL=
INCIDENTOPS_JIRA_TOKEN=
INCIDENTOPS_JIRA_PROJECT=OPS
# ...or the bundled MCP ticket server, which needs both (under docker compose, put the database in
# the data volume: /var/lib/incidentops/tickets.db). Secret: openssl rand -hex 24.
INCIDENTOPS_TICKETS_DB=
INCIDENTOPS_APPROVAL_SECRET=

# ---- Legacy CMDB (W09, SOAP, optional) --------------------------------------------------------------
INCIDENTOPS_CMDB_URL=
INCIDENTOPS_CMDB_API_KEY=

# ---- Ops questions, text-to-SQL (W09, W10, optional) ------------------------------------------------
# A login granted incidentops_ops_reader and mapped to a tenant (docs/deploy.md, step 7).
INCIDENTOPS_OPS_DATABASE_URL=
# Per tenant, JSON: {"tenant-a": "postgresql+asyncpg://..."}. The URL above is tenant "default"'s,
# unless this map names "default" too.
INCIDENTOPS_OPS_DATABASE_URLS={}

# ---- Tracing (W11, optional) ------------------------------------------------------------------------
# A JSONL file of spans (under docker compose: /var/lib/incidentops/traces.jsonl), and/or Langfuse.
INCIDENTOPS_TRACE_FILE=
INCIDENTOPS_LANGFUSE_HOST=
INCIDENTOPS_LANGFUSE_PUBLIC_KEY=
INCIDENTOPS_LANGFUSE_SECRET_KEY=

# ---- Reliability (W12, W13) -------------------------------------------------------------------------
# A run still "running" this long after its last update belonged to a process that died; the API
# looks for such runs every INCIDENTOPS_STALE_RUN_SWEEP_S seconds and makes them resumable.
INCIDENTOPS_STALE_RUN_AFTER_S=900
INCIDENTOPS_STALE_RUN_SWEEP_S=60
