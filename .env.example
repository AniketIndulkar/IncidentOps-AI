# Copy to .env and adjust. Never commit .env.
INCIDENTOPS_DATABASE_URL=postgresql+asyncpg://localhost:5432/incidentops
INCIDENTOPS_DATABASE_ECHO=false

# docker compose only: password for the Postgres container (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# LLM (W02). Create a project-scoped key at platform.openai.com; never commit the real value.
OPENAI_API_KEY=
# Model name from OpenAI's pricing page. Required for real calls; tests never need it.
INCIDENTOPS_LLM_MODEL=
INCIDENTOPS_LLM_TIMEOUT_S=30
INCIDENTOPS_LLM_MAX_ATTEMPTS=3
INCIDENTOPS_LLM_TOTAL_TIMEOUT_S=60
# Who may call the LLM endpoints (they spend money). Callers send it as `Authorization: Bearer <token>`.
# At least 16 characters; generate: openssl rand -hex 24. With an OpenAI key but no token the endpoints stay off.
INCIDENTOPS_API_TOKEN=
# Calls per minute to the LLM endpoints, all callers together, per server process.
INCIDENTOPS_LLM_RATE_LIMIT_PER_MINUTE=10
